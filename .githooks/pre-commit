#!/usr/bin/env bash
set -euo pipefail

if [[ "${SKIP_DOCS_CHECK:-0}" == "1" ]]; then
    exit 0
fi

if git diff --cached --quiet -- \
    fastfetch fish helix kitty nushell nvim tmux yazi install.sh; then
    exit 0
fi

missing=()
if git diff --cached --quiet --diff-filter=ACMR -- README.md; then
    missing+=(README.md)
fi
if git diff --cached --quiet --diff-filter=ACMR -- AGENTS.md; then
    missing+=(AGENTS.md)
fi

if ((${#missing[@]} == 0)); then
    exit 0
fi

printf 'Documentation check failed; stage reviewed updates to:\n' >&2
printf '  %s\n' "${missing[@]}" >&2
printf 'If both documents are intentionally unchanged, use SKIP_DOCS_CHECK=1 and explain why in the commit message.\n' >&2
exit 1
