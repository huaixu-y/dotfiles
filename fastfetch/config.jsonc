{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": { "right": 3 },
    "color": { "1": "#89b4fa", "2": "#cba6f7" }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 19 },
    "color": { "output": "#cdd6f4" },
    "percent": {
      "type": ["num", "bar", "num-color"],
      "color": { "green": "#a6e3a1", "yellow": "#f9e2af", "red": "#f38ba8" }
    },
    "bar": {
      "char": { "elapsed": "━", "total": "━" },
      "width": 10,
      "border": null,
      "color": { "elapsed": "#b4befe", "total": "#45475a" }
    }
  },
  "modules": [
    { "type": "title", "color": { "user": "#89b4fa", "at": "#6c7086", "host": "#89b4fa" } },
    "break",
    { "type": "custom", "format": "┏━ Hardware", "outputColor": "#89b4fa" },
    { "type": "host", "key": "├─ 󰌢 Host", "keyColor": "#89b4fa" },
    { "type": "cpu", "key": "├─ 󰻠 CPU", "keyColor": "#89b4fa" },
    { "type": "gpu", "key": "├─ 󰢮 GPU", "keyColor": "#89b4fa" },
    { "type": "memory", "key": "├─ 󰍛 Memory", "keyColor": "#89b4fa" },
    { "type": "swap", "key": "├─ 󰓡 Swap", "keyColor": "#89b4fa" },
    {
      "type": "disk",
      "key": "├─ 󰋊 Disk",
      "keyColor": "#89b4fa",
      "format": "{size-percentage-bar} {size-used} / {size-total} ({size-percentage}) · {filesystem} [{mountpoint}]"
    },
    { "type": "display", "key": "└─ 󰍹 Display", "keyColor": "#89b4fa" },
    "break",
    { "type": "custom", "format": "┏━ Software", "outputColor": "#a6e3a1" },
    { "type": "os", "key": "├─  OS", "keyColor": "#a6e3a1" },
    { "type": "kernel", "key": "├─ 󰒓 Kernel", "keyColor": "#a6e3a1" },
    { "type": "uptime", "key": "├─ 󰅐 Uptime", "keyColor": "#a6e3a1", "format": "{?days}{days}d {?}{hours}h {minutes}m" },
    { "type": "packages", "key": "├─ 󰏗 Packages", "keyColor": "#a6e3a1" },
    { "type": "shell", "key": "├─ 󰆍 Shell", "keyColor": "#a6e3a1" },
    { "type": "locale", "key": "└─ 󱪫 Locale", "keyColor": "#a6e3a1" },
    "break",
    { "type": "custom", "format": "┏━ Desktop", "outputColor": "#cba6f7" },
    { "type": "de", "key": "├─ 󰧨 DE", "keyColor": "#cba6f7" },
    { "type": "wm", "key": "├─ 󰖲 WM", "keyColor": "#cba6f7" },
    { "type": "wmtheme", "key": "├─ 󰉼 WM Theme", "keyColor": "#cba6f7" },
    { "type": "theme", "key": "├─ 󰸌 Theme", "keyColor": "#cba6f7" },
    { "type": "icons", "key": "├─ 󰀻 Icons", "keyColor": "#cba6f7" },
    { "type": "font", "key": "├─ 󰛖 Font", "keyColor": "#cba6f7" },
    { "type": "cursor", "key": "└─ 󰇀 Cursor", "keyColor": "#cba6f7" },
    "break",
    { "type": "custom", "format": "┏━ Terminal", "outputColor": "#94e2d5" },
    { "type": "terminal", "key": "├─  Terminal", "keyColor": "#94e2d5" },
    { "type": "terminalfont", "key": "└─  Terminal Font", "keyColor": "#94e2d5" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
